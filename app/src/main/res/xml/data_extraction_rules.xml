<?xml version="1.0" encoding="utf-8"?>
<!--
  Call recordings and deals are sensitive. This rule blocks both cloud backup
  and device-to-device transfer, so the data never leaves the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
